{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collector Source",
  "type": "object",
  "required": [
    "source_id",
    "url",
    "format",
    "enabled",
    "priority",
    "timeout_seconds",
    "max_bytes",
    "max_redirects",
    "trust_level",
    "public_redistribution"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{1,63}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "format": {
      "enum": [
        "auto",
        "plain",
        "base64",
        "json"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10485760
    },
    "max_redirects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "trust_level": {
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "public_redistribution": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
